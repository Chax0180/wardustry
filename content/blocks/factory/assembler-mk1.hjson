type: MultiCrafter
  
name: Assembler Mk.1
description: A multi-purpose machine which can print and assemble certain components.
size: 3
health: 800
itemCapacity: 20
liquidcapacity: 40
requirements:[
steel/80
iron/40
aluminum/200
silicon/120
]
category: crafting
conductivePower: true

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawDefault
    }
  ]
}

# The library specific variables
jsonRecipes: [
    {
        name: am1-aluminum-truss
        input: {
            items: [aluminum/5]
            power: 1
        }
        output: {
            items: [aluminum-truss/2]
        }
        craftTime: 600
        unlocked: true
    }
]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      padding: 2
      drawLiquid: water
    }
    {
      type: DrawPistons
      suffix: -laserThing
      sinMag: 2
      sinScl: 0.1
      sides: 1
    }
    {
      type: DrawPistons
      suffix: -printer
      sinMag: 24
      sinScl: 20
      sides: 1
    }
    {
      type: DrawDefault
    }
  ]
}
