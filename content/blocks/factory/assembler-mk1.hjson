type: MultiCrafter
  
name: Assembler Mk.1
description: A multi-purpose machine which can print and assemble certain components.
size: 3
health: 800
itemCapacity: 20
liquidcapacity: 40
requirements:[
steel/80
iron/40
aluminum/200
silicon/120
]
category: crafting
conductivePower: true

# The library specific variables
jsonRecipes: [
    {
        name: am1-aluminum-truss
        input: {
            items: [aluminum/5]
            liquids: [water/0.2]
            power: 1
        }
        output: {
            items: [aluminum-truss/2]
        }
        craftTime: 600
        unlocked: true
    }
]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      padding: 2
      drawLiquid: water
    }
    {
      type: DrawRegion
      suffix: -spinner1
      x: 1.54
      y: -2.8
      spinSprite: true
      rotateSpeed: 1
    }
    {
      type: DrawRegion
      suffix: -spinner2
      x: 7
      y: -2.8
      spinSprite: true
      rotateSpeed: 0.5
    }
    {
      type: DrawPistons
      suffix: -laserthing
      sinMag: 3
      sinScl: 1
      sides: 1
    }
    {
      type: DrawPistons
      suffix: -printer
      y: -6.6
      angleOffset: 90
      sinMag: 15
      sinScl: 6
      sides: 1
    }
    {
      type: DrawDefault
    }
  ]
}
