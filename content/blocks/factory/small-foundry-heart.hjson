type: MultiCrafter
  
name: Small Foundry Heart
description: Melts down certaian metals for use in alloying recipes.
size: 2
health: 1200
armor: 2
itemCapacity: 10
liquidcapacity: 24
requirements:[
concrete/64
iron/80
aluminum/60
]
category: crafting
conductivePower: true

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawDefault
    }
  ]
}

# The library specific variables
jsonRecipes: [
    {
        name: steel
        input: {
            items: [iron/3, coal/1]
            liquids: [oil/0.4]
            power: 2
        }
        output: {
            liquids: [molten-steel/0.2]
        }
        craftTime: 60
        unlocked: true
    }
    {
        name: silicon
        input: {
            items: [sand/10, coal/3]
            power: 2
        }
        output: {
            liquids: [molten-silicon/0.2]
        }
        craftTime: 90
        unlocked: true
    }
]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      padding: 3
      drawLiquid: molten-silicon
    }
    {
      type: DrawLiquidTile
      padding: 3
      drawLiquid: molten-steel
    }
    {
      type: DrawDefault
    }
  ]
}
